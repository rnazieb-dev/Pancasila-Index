# ---- Database (lapisan dinamis: akun/review/log) ----
DATABASE_URL="file:./dev.db"
# Saat produksi (Postgres): DATABASE_URL="postgresql://user:pass@host:5432/pancasila"

# ---- Autentikasi GitHub ----
GITHUB_ID=
GITHUB_SECRET=
AUTH_SECRET=isi-random-string-panjang
# Login GitHub yang otomatis dapat peran KURATOR (pisah koma)
CURATOR_GITHUB_LOGINS=

# Mode pengembangan kurasi tanpa login (JANGAN dipakai produksi)
CURATION_DEV=
