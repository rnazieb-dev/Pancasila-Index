# ---- Database (lapisan dinamis: akun/review/log) ----
# Provider Prisma = postgresql. SQLite tidak dipakai lagi: filesystem Vercel
# bersifat ephemeral & read-only, jadi tulis ke file DB akan gagal saat runtime.
DATABASE_URL="postgresql://user:pass@host:5432/pancasila?sslmode=require"
# Lokal via Docker: docker run --name pancasila-pg -e POSTGRES_PASSWORD=pancasila \
#   -e POSTGRES_DB=pancasila -p 5432:5432 -d postgres:17
# lalu: DATABASE_URL="postgresql://postgres:pancasila@localhost:5432/pancasila"

# ---- Autentikasi GitHub ----
GITHUB_ID=
GITHUB_SECRET=
AUTH_SECRET=isi-random-string-panjang
# Login GitHub yang otomatis dapat peran KURATOR (pisah koma)
CURATOR_GITHUB_LOGINS=

# Mode pengembangan kurasi tanpa login. LOKAL SAJA.
# Memberi peran KURATOR ke setiap pengunjung tanpa login. Kode menolaknya bila
# NODE_ENV=production, tetapi jangan mengandalkan itu: cukup satu keputusan
# "rejected" untuk mengeluarkan penilaian dari dataset publik, dan jejak
# auditnya tidak menunjuk siapa pun.
CURATION_DEV=

# ---- Kurasi (fase 5b) ----
# Webhook opsional: setiap keputusan kurasi dikirim sebagai POST JSON
# { assessmentId, decision, reviewer, note, status, term } ke URL ini.
# Kosong = nonaktif. Cocok untuk notifikasi Slack/Discord/ntfy lokal.
KURASI_WEBHOOK_URL=

# ---- Vercel AI Gateway (audio/text-to-speech) ----
# Pada Vercel deployment, AI_GATEWAY_API_KEY di-set otomatis oleh
# integrasi Vercel AI Gateway (https://vercel.com/docs/ai-gateway).
# Untuk lokal: kosongkan (audio akan return 503 dengan pesan informatif).
# AI_GATEWAY_API_KEY=

# ---- Pembukaan Pull Request otomatis (opsional) ----
# Memungkinkan kurator membuka PR dari /kurasi/usulan tanpa menyentuh Git.
# Kosongkan (GITHUB_CANONICAL_REPO saja sudah cukup untuk menonaktifkan) untuk
# menonaktifkan: antarmuka akan kembali menampilkan patch YAML untuk disalin
# manual.
#
# WAJIB dipenuhi sebelum diaktifkan:
#  1. Gunakan GitHub App terpasang (bukan Personal Access Token pribadi).
#     Izin minimal: Contents = Read & write, Pull requests = Read & write.
#     JANGAN beri Administration atau Workflows. Webhook boleh dimatikan
#     (Active = off) - App ini tidak menerima event apa pun.
#  2. Aktifkan branch protection pada cabang utama: wajib pull request, minimal
#     2 approving review, dan larang bypass. Aplikasi hanya boleh MENGUSULKAN;
#     penggabungan tetap keputusan manusia.
#  3. Kunci privat disimpan sebagai secret di penyedia hosting, tidak pernah
#     di repo, tidak pernah di riwayat git.
GITHUB_CANONICAL_REPO=
GITHUB_BASE_BRANCH=main

# Jalur utama: token instalasi diterbitkan sendiri dari App ID + kunci privat,
# berlaku ~1 jam dan diperbarui otomatis di setiap panggilan - tidak ada token
# statis yang perlu diputar manual atau bisa kedaluwarsa diam-diam.
#
# Ambil dari halaman GitHub App -> Settings -> General (App ID), dan dari URL
# setelah "Install App" (Installation ID, angka di /installations/<ID>).
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# Isi dari file .pem hasil "Generate a private key" pada halaman App. Bisa
# ditempel APA ADANYA dengan baris baru sungguhan (banyak dashboard mendukung
# nilai multi-baris), atau sebagai satu baris dengan "\n" literal menggantikan
# baris baru - keduanya diterima.
GITHUB_APP_PRIVATE_KEY=

# Jalur cadangan untuk pengujian cepat SEBELUM GitHub App terpasang: token
# statis (mis. classic Personal Access Token). TIDAK disarankan untuk
# produksi - token begini melekat pada satu akun pribadi, bukan pada
# instalasi yang scoped ke repo tunggal. Diabaikan bila ketiga GITHUB_APP_*
# di atas sudah terisi lengkap.
GITHUB_PR_TOKEN=
