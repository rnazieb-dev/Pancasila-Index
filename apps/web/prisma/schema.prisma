// Pancasila Index — lapisan dinamis (akun, review, komentar, audit).
// Kanonik untuk PENILAIAN tetap YAML di git; tabel di sini hanya overlay
// interaktif. Postgres untuk lokal & produksi (Vercel serverless tidak bisa
// menulis ke SQLite: filesystem-nya ephemeral & read-only).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  KURATOR
  KONTRIBUTOR
  PEMBACA
}

enum Decision {
  APPROVED
  REJECTED
}

enum UsulanStatus {
  DRAFT
  PENDING_REVIEW
  PENDING_SECOND
  PUBLISHED
  REJECTED
}

model User {
  id             String    @id @default(cuid())
  email          String?   @unique
  passwordHash   String?
  name           String?
  image          String?
  affiliation    String?
  title          String?   // gelar akademis / jabatan
  funding        String?   // default funding disclosure
  bio            String?
  githubId       String?   @unique
  role           Role      @default(KONTRIBUTOR)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  reviews        Review[]
  comments       Comment[]
  audits         AuditLog[]
  ckanAudits     CkanAudit[]
  usulan         Usulan[]
}

/// Satu baris per keputusan kurasi; keputusan TERAKHIR per assessmentId
/// yang menang. Diecermin ke generated/review-state.json oleh API
/// (write-through) agar build dataset tetap berjalan tanpa database.
model Review {
  id           String    @id @default(cuid())
  assessmentId String
  decision     Decision
  note         String?
  reviewer     User?     @relation(fields: [reviewerId], references: [id])
  reviewerId   String?
  reviewerName String // snapshot nama saat memutuskan
  createdAt    DateTime  @default(now())

  @@index([assessmentId, createdAt])
}

model Comment {
  id           String   @id @default(cuid())
  assessmentId String
  body         String
  author       User     @relation(fields: [authorId], references: [id])
  authorId     String
  createdAt    DateTime @default(now())

  @@index([assessmentId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     User?    @relation(fields: [actorId], references: [id])
  actorId   String?
  action    String // contoh: "review.create", "auth.signin", "role.grant"
  entity    String // contoh: "Review", "User"
  entityId  String?
  meta      String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

enum RadarStatus {
  PENDING
  AUDITED
  IGNORED
}

model CkanRadarItem {
  id                String      @id @default(cuid())
  resourceId        String      @unique
  packageId         String
  title             String
  agency            String
  metadata          Json?
  aiExtractedClaim  String?
  relevantDimension String?
  status            RadarStatus @default(PENDING)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @default(now()) @updatedAt

  @@index([status, createdAt])
}

/// Usulan bukti primer yang diajukan kontributor. Disimpan di DB (overlay
/// interaktif) dan di-mirror ke fallback JSON agar tetap tampil saat
/// DATABASE_URL belum aktif di lingkungan lokal/dev.
model Usulan {
  id            String       @id @default(cuid())
  publicId      String       @unique
  institutionId String
  termId        String
  dimensionId   String
  sourceType    String
  sourceTitle   String?
  sourceUrl     String
  argumentasi   String
  nama          String
  afiliasi      String?
  funding       String?
  pakta         Boolean      @default(false)
  status        UsulanStatus @default(PENDING_REVIEW)
  /// Nama penelaah — untuk DITAMPILKAN saja.
  /// JANGAN dipakai menghitung kuorum: nama dapat diubah pemiliknya, sehingga
  /// satu akun bisa lolos sebagai dua penelaah.
  reviewerNames String[]     @default([])
  /// Identitas stabil penelaah (User.id) — INI yang menentukan kuorum.
  reviewerIds   String[]     @default([])
  /// Catatan kurator. Wajib terisi ketika usulan ditolak.
  reviewNote    String?
  author        User?        @relation(fields: [authorId], references: [id])
  authorId      String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt

  @@index([authorId, createdAt])
}

model CkanAudit {
  id                String    @id @default(cuid())
  resourceId        String
  baseUrl           String
  title             String
  contextNote       String
  relevantDimension String
  contributorId     String?
  contributor       User?     @relation(fields: [contributorId], references: [id])
  status            String    @default("pending") // pending, pending_second, published, rejected
  /// Nama tampilan penyetuju — untuk DITAMPILKAN ke publik saja.
  /// JANGAN dipakai menghitung kuorum: nama bisa diubah pemiliknya, sehingga
  /// satu akun dapat menyetujui dua kali dengan mengganti namanya.
  approverNames     String[]  @default([])
  /// Identitas stabil penyetuju (User.id) — INI yang menentukan kuorum.
  /// Tidak pernah ditampilkan ke publik.
  approverIds       String[]  @default([])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status, createdAt])
}
