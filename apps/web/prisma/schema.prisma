// Pancasila Index — lapisan dinamis (akun, review, komentar, audit).
// Kanonik untuk PENILAIAN tetap YAML di git; tabel di sini hanya overlay
// interaktif. Postgres untuk lokal & produksi (Vercel serverless tidak bisa
// menulis ke SQLite: filesystem-nya ephemeral & read-only).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  KURATOR
  KONTRIBUTOR
  PEMBACA
}

enum Decision {
  APPROVED
  REJECTED
}

model User {
  id             String    @id @default(cuid())
  email          String?   @unique
  passwordHash   String?
  name           String?
  image          String?
  affiliation    String?
  title          String?   // gelar akademis / jabatan
  funding        String?   // default funding disclosure
  bio            String?
  githubId       String?   @unique
  role           Role      @default(KONTRIBUTOR)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  reviews        Review[]
  comments       Comment[]
  audits         AuditLog[]
}

/// Satu baris per keputusan kurasi; keputusan TERAKHIR per assessmentId
/// yang menang. Diecermin ke generated/review-state.json oleh API
/// (write-through) agar build dataset tetap berjalan tanpa database.
model Review {
  id           String    @id @default(cuid())
  assessmentId String
  decision     Decision
  note         String?
  reviewer     User?     @relation(fields: [reviewerId], references: [id])
  reviewerId   String?
  reviewerName String // snapshot nama saat memutuskan
  createdAt    DateTime  @default(now())

  @@index([assessmentId, createdAt])
}

model Comment {
  id           String   @id @default(cuid())
  assessmentId String
  body         String
  author       User     @relation(fields: [authorId], references: [id])
  authorId     String
  createdAt    DateTime @default(now())

  @@index([assessmentId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     User?    @relation(fields: [actorId], references: [id])
  actorId   String?
  action    String // contoh: "review.create", "auth.signin", "role.grant"
  entity    String // contoh: "Review", "User"
  entityId  String?
  meta      String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

enum RadarStatus {
  PENDING
  AUDITED
  IGNORED
}

model CkanRadarItem {
  id                String      @id @default(cuid())
  resourceId        String      @unique
  packageId         String
  title             String
  agency            String
  metadata          Json?
  aiExtractedClaim  String?
  relevantDimension String?
  status            RadarStatus @default(PENDING)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @default(now()) @updatedAt

  @@index([status, createdAt])
}
